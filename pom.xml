<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>4.0.9</version>
    <relativePath/>
  </parent>

  <groupId>fr.plb.sirh</groupId>
  <artifactId>sirh-export</artifactId>
  <version>1.0.0-SNAPSHOT</version>
  <packaging>pom</packaging>

  <modules>
    <module>sirh-export-core</module>
    <module>sirh-export-format-sage</module>
    <module>sirh-export-api</module>
  </modules>

  <properties>
    <java.version>21</java.version>
    <springdoc.version>3.2.0</springdoc.version>
    <rest-assured.version>6.3.0</rest-assured.version>
    <cucumber.version>8.0.4</cucumber.version>
  </properties>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>fr.plb.sirh</groupId>
        <artifactId>sirh-export-core</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>fr.plb.sirh</groupId>
        <artifactId>sirh-export-format-sage</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>org.springdoc</groupId>
        <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
        <version>${springdoc.version}</version>
      </dependency>
      <dependency>
        <groupId>io.rest-assured</groupId>
        <artifactId>rest-assured</artifactId>
        <version>${rest-assured.version}</version>
      </dependency>
      <dependency>
        <groupId>io.cucumber</groupId>
        <artifactId>cucumber-bom</artifactId>
        <version>${cucumber.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <!-- Atelier A04 : à compléter avec distributionManagement vers Nexus -->
</project>
